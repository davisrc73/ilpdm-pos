# =============================================================================
# Copiar para .env e preencher. O .env NUNCA deve ir para o Git.
# Cada ambiente (local, NAS) tem o seu próprio .env com valores diferentes.
# =============================================================================

# Timezone do container (datas em logs e timestamps)
TZ=Europe/Lisbon

# Porta do host onde o PocketBase fica exposto (bind a 127.0.0.1, nunca 0.0.0.0).
# O DSM Reverse Proxy ou o browser apontam para esta porta.
# Valores típicos:
#   - Mac local:  8090
#   - NAS:        8095  (outro container já ocupa 8090)
PB_HOST_PORT=8090

# Chave de encriptação dos settings sensíveis do PocketBase (SMTP, OAuth, S3).
# Gerar com:  openssl rand -hex 32
# IMPORTANTE: Guardar esta chave fora do NAS (gestor de passwords).
# Perder esta chave = perder acesso aos settings encriptados.
# Cada ambiente DEVE ter chave própria — nunca reutilizar entre local e NAS.
PB_ENCRYPTION_KEY=
