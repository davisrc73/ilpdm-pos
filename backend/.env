# Timezone do container (datas em logs e timestamps)
TZ=Europe/Lisbon

# Chave de encriptação dos settings do PocketBase.
# Gerar com:  openssl rand -hex 32
# IMPORTANTE: Guardar esta chave fora do NAS (gestor de passwords).
# Perder esta chave torna os settings encriptados irrecuperáveis.
PB_ENCRYPTION_KEY=7c1f60c1aaf8036d7b61355d188336cd5326884f90fa674fc329de2c88946870
